# Public Supabase credentials (safe to expose; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Absolute URL of this app, used for auth email redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 2: public booking + AI receptionist (server-only secrets) ---
# Service role key: used ONLY inside route handlers / server actions for
# anonymous visitors (booking, chat). Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI provider: "gemini" (default, reuses your existing key) or "anthropic"
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-opus-5

# Optional: model for the interpreter's server-side speech-to-text fallback (Gemini audio)
# GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash

# --- Phase 4: automations ---
# Shared secret for the scheduler (Vercel Cron sends it as "Authorization: Bearer <secret>")
CRON_SECRET=change-me
# SMS via Twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM_NUMBER=+13175550000
# Email via Resend
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM="Nail Bar <hello@yourdomain.com>"
# Log messages instead of sending them (handy while testing)
# MESSAGING_DRY_RUN=true

# --- Phase 5: marketing ---
# Facebook Page connections are entered per salon in Dashboard → Marketing.

# --- Phase 6: billing + hardening ---
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx           # endpoint: /api/webhooks/stripe
# STRIPE_PRICE_PRO=price_xxx                # monthly price ids from the Stripe dashboard
# STRIPE_PRICE_PREMIUM=price_xxx
# Exact rate limits across serverless instances (optional; falls back to in-memory)
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx
